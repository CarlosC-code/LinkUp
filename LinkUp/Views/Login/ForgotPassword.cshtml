@model ForgotPasswordRequestViewModel

@{
    ViewData["Title"] = "Forgot password";
    Layout = "_LayoutAnonymous";
}

<div class="d-flex justify-content-center align-items-center" style="min-height:75vh;">

    <div class="col-12 col-md-5">

        <div style="background:#2b2b2b;
                    border-radius:12px;
                    box-shadow:0 0 20px rgba(0,0,0,0.5);
                    overflow:hidden;">

            <!-- Header -->
            <div style="background:#1f5130;
                        padding:15px;
                        text-align:center;
                        color:#ffffff;">
                <h5 class="mb-0">Forgot Password</h5>
            </div>

            <div style="padding:25px;">

                @if (ViewBag.HasError != null && ViewBag.HasError)
                {
                    <div style="background:#4b1c1c;
                                    color:#f8d7da;
                                    border-radius:8px;
                                    padding:15px;
                                    margin-bottom:15px;
                                    position:relative;">

                        @foreach (var error in ViewBag.Errors)
                        {
                            <p class="mb-1">@error</p>
                        }

                        <button type="button"
                                class="btn-close btn-close-white position-absolute top-0 end-0 m-3"
                                data-bs-dismiss="alert">
                        </button>
                    </div>
                }

                <form asp-controller="Login"
                      asp-action="ForgotPassword"
                      method="POST">

                    <div class="mb-4">
                        <label asp-for="UserName"
                               class="form-label text-light">
                            UserName
                        </label>

                        <input asp-for="UserName"
                               class="form-control bg-dark text-light border-secondary"
                               placeholder="Enter your username" />

                        <span asp-validation-for="UserName"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">

                        <a asp-controller="Login"
                           asp-action="Index"
                           class="btn btn-outline-light">
                            <i class="bi bi-arrow-left-short"></i> Back
                        </a>

                        <button type="submit"
                                class="btn"
                                style="background:#4da6ff;color:white;">
                            <i class="bi bi-floppy2"></i> Send
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
</div>