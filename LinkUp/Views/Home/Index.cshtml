@model LinkUp.Core.Application.ViewModels.Social.HomeFeedViewModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="container-fluid min-vh-100" style="background:#0f172a;">

    <!-- Top bar estilo oscuro moderno -->
    <div class="sticky-top shadow-sm"
         style="background:#111827; border-bottom:1px solid #1f2937;">

        <div class="container col-12 col-md-8 col-lg-6 py-3 d-flex justify-content-between align-items-center">

            <h4 class="fw-bold mb-0" style="letter-spacing:2px; color:#c084fc;">
                <i class="bi bi-lightning-charge-fill me-1"></i>LinkUp
            </h4>

            <div>
                <a asp-controller="FriendRequests" asp-action="Index"
                   class="position-relative fs-5 text-decoration-none"
                   style="color:#c084fc; transition:0.3s;">

                    <i class="bi bi-heart-fill"></i>

                    @if (Model.PendingRequestsCount > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill"
                              style="background:#9333ea; box-shadow:0 0 12px rgba(147,51,234,0.6);">
                            @Model.PendingRequestsCount
                        </span>
                    }
                </a>
            </div>

        </div>
    </div>

    <!-- Feed centrado -->
    <div class="container col-12 col-md-8 col-lg-6 py-4">

        <!-- Crear publicación -->
        <div class="card border-0 mb-4 shadow-lg rounded-4"
             style="background:#1f2937; border:1px solid #312e81;">

            <div class="card-body text-light">
                <partial name="~/Views/Shared/_CreatePost.cshtml" model="Model.NewPost" />
            </div>
        </div>

        <!-- Publicaciones -->
        @if (!Model.MyPosts.Any())
        {
            <div class="text-center mt-5 p-5 rounded-4 shadow-sm"
                 style="background:#1f2937; border:1px solid #312e81;">

                <i class="bi bi-camera fs-1" style="color:#a855f7;"></i>
                <p class="mt-3 fw-semibold text-light">
                    Aún no tienes publicaciones.
                </p>
            </div>
        }
        else
        {
            @foreach (var p in Model.MyPosts)
            {
                <div class="card border-0 mb-4 shadow-lg rounded-4 overflow-hidden"
                     style="background:#1f2937; border:1px solid #312e81; transition:0.3s;">

                    <div class="card-body p-0 text-light">
                        <partial name="~/Views/Shared/_PostCard.cshtml" model="p" />
                    </div>
                </div>
            }
        }

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}