@model List<LinkUp.Core.Application.ViewModels.Social.PostItemViewModel>
@{
    ViewData["Title"] = "Publicaciones del amigo";
}

<div class="container-fluid min-vh-100"
     style="background:#0f172a;">

    <!-- Top Bar Dark -->
    <div class="sticky-top shadow-sm"
         style="background:#111827; border-bottom:1px solid #1f2937;">

        <div class="container col-12 col-md-8 col-lg-6 py-3 d-flex justify-content-between align-items-center">

            <div class="d-flex align-items-center">

                <a asp-controller="Friends"
                   asp-action="Index"
                   class="me-3 fs-5 text-decoration-none d-flex align-items-center justify-content-center rounded-circle"
                   style="width:40px; height:40px; background:#1f2937; color:#c084fc; transition:0.3s;">

                    <i class="bi bi-arrow-left"></i>
                </a>

                <h5 class="fw-bold mb-0"
                    style="color:#e5e7eb; letter-spacing:1px;">
                    Publicaciones
                </h5>

            </div>

        </div>
    </div>

    <!-- Feed centrado -->
    <div class="container col-12 col-md-8 col-lg-6 py-4">

        @if (!Model.Any())
        {
            <div class="text-center mt-5 p-5 rounded-4 shadow-sm"
                 style="background:#111827; border:1px solid #312e81;">

                <i class="bi bi-camera fs-1"
                   style="color:#a855f7;"></i>

                <p class="mt-3 mb-1 fw-semibold"
                   style="color:#e5e7eb;">
                    Este usuario aún no tiene publicaciones.
                </p>

                <small style="color:#9ca3af;">
                    Cuando publique algo lo verás aquí.
                </small>
            </div>
        }
        else
        {
            @foreach (var p in Model)
            {
                <div class="card border-0 mb-4 shadow-lg rounded-4 overflow-hidden"
                     style="background:#111827;
                                    border:1px solid #312e81;
                                    transition:0.3s;">

                    <div class="card-body p-0 text-light">
                        <partial name="~/Views/Shared/_PostCard.cshtml" model="p" />
                    </div>
                </div>
            }
        }

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}