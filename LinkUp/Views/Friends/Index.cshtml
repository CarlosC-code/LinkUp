@model LinkUp.Core.Application.ViewModels.Social.HomeFeedViewModel
@{
    ViewData["Title"] = "Amigos";
}

<div class="container-fluid min-vh-100"
     style="background:#0f172a;">

    <!-- Top bar Dark -->
    <div class="sticky-top shadow-sm"
         style="background:#111827; border-bottom:1px solid #1f2937;">

        <div class="container col-12 col-md-8 col-lg-6 py-3 d-flex justify-content-between align-items-center">

            <div>
                <h4 class="fw-bold mb-0"
                    style="letter-spacing:2px; color:#c084fc;">
                    <i class="bi bi-people-fill me-1"></i>
                    LinkUp
                </h4>
                <span style="color:#9ca3af; font-size:0.85rem;">
                    Publicaciones de tus amigos
                </span>
            </div>

        </div>
    </div>

    <!-- Feed centrado -->
    <div class="container col-12 col-md-8 col-lg-6 py-4">

        @if (!Model.MyPosts.Any())
        {
            <div class="text-center mt-5 p-5 rounded-4 shadow-sm"
                 style="background:#111827; border:1px solid #312e81;">

                <i class="bi bi-people fs-1"
                   style="color:#a855f7;"></i>

                <p class="mt-3 mb-1 fw-semibold"
                   style="color:#e5e7eb;">
                    Aún no hay publicaciones de tus amigos.
                </p>

                <small style="color:#9ca3af;">
                    Cuando publiquen algo lo verás aquí.
                </small>
            </div>
        }
        else
        {
            @foreach (var p in Model.MyPosts)
            {
                <div class="card border-0 mb-4 shadow-lg rounded-4 overflow-hidden"
                     style="background:#111827;
                                    border:1px solid #312e81;
                                    transition:0.3s;">

                    <div class="card-body p-0 text-light">
                        <partial name="~/Views/Shared/_PostCard.cshtml" model="p" />
                    </div>
                </div>
            }
        }

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}