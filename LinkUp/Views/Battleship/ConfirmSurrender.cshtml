@model int
@{
    ViewData["Title"] = "Confirmar rendición";
}

<div class="container py-3">
    <h3>¿Está seguro que desea rendirse?</h3>

    <div class="d-flex gap-2 mt-2">
        <a asp-action="AttackBoard" class="btn btn-secondary">Cancelar</a>

        <form asp-action="Surrender" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="gameId" value="@Model" />
            <button type="submit" class="btn btn-danger">Aceptar</button>
        </form>
    </div>
</div>