@model List<LinkUp.Core.Application.ViewModels.Battleship.BoardCellViewModel>
<div class="table-responsive">
    <table class="table table-bordered text-center align-middle">
        <tbody>
            @for (int r = 0; r < 12; r++)
            {
                <tr>
                    @for (int c = 0; c < 12; c++)
                    {
                        var cell = Model.First(x => x.Row == r && x.Col == c);
                        var cls = cell.IsHit.HasValue ? (cell.IsHit.Value ? "bg-danger" : "bg-success") : "";
                        <td class="@cls" style="width:32px;height:32px;"></td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
