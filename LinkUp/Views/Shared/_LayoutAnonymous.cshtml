<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LinkUpApp</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ItlaInvestmentApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <style>
        body {
            background-color: #1e1e1e;
            color: #e4e4e4;
        }

        .navbar {
            background-color: #2b2b2b !important;
            border-bottom: 1px solid #3a3a3a !important;
        }

        .navbar-brand {
            color: #ffffff !important;
            font-weight: 600;
        }

            .navbar-brand:hover {
                color: #d1d1d1 !important;
            }

        .footer {
            background-color: #2b2b2b;
            color: #9ca3af !important;
            border-top: 1px solid #3a3a3a !important;
            padding: 15px 0;
        }

        .container {
            background-color: transparent;
        }

        a {
            color: #4da6ff;
        }

            a:hover {
                color: #80c1ff;
            }
    </style>
</head>
<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-dark box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Login" asp-action="Index">
                    LinkUpApp
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-center mt-4">
        <div class="container">
            &copy; @DateTime.Now.Year - LinkUpApp
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>