@model LinkUp.Core.Application.ViewModels.Social.PostItemViewModel
@{
    ViewData["Title"] = "Eliminar publicación";
}

<style>
    body {
        background-color: #212121;
        color: #e0e0e0;
    }

    .dark-card {
        background-color: #2a2a2a;
        border-radius: 14px;
        padding: 25px;
        max-width: 800px;
        margin: 40px auto;
        box-shadow: 0 0 25px rgba(0,0,0,0.4);
    }

    .card {
        background-color: #2f2f2f;
        border: 1px solid #3a3a3a;
        color: #e0e0e0;
    }

    .card-body {
        padding: 20px;
    }

    .text-muted {
        color: #aaaaaa !important;
    }

    .btn-secondary {
        background-color: #444;
        border: none;
    }

        .btn-secondary:hover {
            background-color: #555;
        }

    .btn-danger {
        border: none;
    }

        .btn-danger:hover {
            background-color: #b02a37;
        }

    h3 {
        font-weight: 600;
    }
</style>

<div class="dark-card">

    <h3 class="mb-4">
        ¿Seguro que deseas eliminar esta publicación?
    </h3>

    <div class="card my-3">
        <div class="card-body">

            <p>@Model.Content</p>

            @if (Model.MediaType == LinkUp.Core.Domain.Common.Enums.MediaType.Image
                        && !string.IsNullOrEmpty(Model.ImagePath))
            {
                <div class="mt-2 small text-muted">
                    Imagen: @Model.ImagePath
                </div>
            }
            else if (Model.MediaType == LinkUp.Core.Domain.Common.Enums.MediaType.YouTube
            && !string.IsNullOrEmpty(Model.YouTubeUrl))
            {
                <div class="mt-2 small text-muted">
                    Video de YouTube
                </div>
            }

            <div class="mt-3">
                <small class="text-muted">
                    Publicado @Model.PublishedAtUtc.ToLocalTime()
                </small>
            </div>

        </div>
    </div>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="d-flex gap-2">
            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-secondary px-4">
                Cancelar
            </a>

            <button class="btn btn-danger px-4">
                Eliminar
            </button>
        </div>
    </form>

</div>