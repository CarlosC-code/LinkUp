@model LinkUp.Core.Application.ViewModels.Social.PostEditViewModel
@using LinkUp.Core.Domain.Common.Enums
@{
    ViewData["Title"] = "Editar publicación";
}

<style>
    body {
        background-color: #212121;
        color: #e0e0e0;
    }

    .dark-card {
        background-color: #2a2a2a;
        border-radius: 14px;
        padding: 30px;
        max-width: 900px;
        margin: 40px auto;
        box-shadow: 0 0 25px rgba(0,0,0,0.4);
    }

    .form-control,
    .form-select {
        background-color: #333;
        border: 1px solid #444;
        color: #fff;
    }

        .form-control:focus,
        .form-select:focus {
            background-color: #333;
            color: #fff;
            border-color: #666;
            box-shadow: none;
        }

    textarea {
        resize: none;
    }

    .btn-primary {
        background-color: #10a37f;
        border: none;
    }

        .btn-primary:hover {
            background-color: #0d8f6f;
        }

    .btn-secondary {
        background-color: #444;
        border: none;
    }

        .btn-secondary:hover {
            background-color: #555;
        }

    .text-muted {
        color: #aaaaaa !important;
    }

    h3 {
        font-weight: 600;
    }
</style>

<div class="dark-card">

    <h3 class="mb-4">Editar publicación</h3>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ExistingImagePath" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- Contenido -->
        <div class="mb-4">
            <label asp-for="Content" class="form-label"></label>
            <textarea asp-for="Content" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Content" class="text-danger"></span>
        </div>

        <div class="row g-3">

            <!-- Tipo -->
            <div class="col-md-3">
                <label asp-for="MediaType" class="form-label">Tipo</label>
                <select asp-for="MediaType" class="form-select">
                    <option value="@((int)MediaType.Image)">Imagen</option>
                    <option value="@((int)MediaType.YouTube)">YouTube</option>
                </select>
                <span asp-validation-for="MediaType" class="text-danger"></span>
            </div>

            <!-- Imagen -->
            <div class="col-md-5">
                <label asp-for="ImageFile" class="form-label">Imagen (opcional)</label>
                <input asp-for="ImageFile" type="file" class="form-control" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>

                @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
                {
                    <div class="mt-3">
                        <div class="text-muted">Imagen actual:</div>
                        <div class="small">@Model.ExistingImagePath</div>
                    </div>
                }
            </div>

            <!-- YouTube -->
            <div class="col-md-4">
                <label asp-for="YouTubeUrl" class="form-label">URL de YouTube</label>
                <input asp-for="YouTubeUrl"
                       class="form-control"
                       placeholder="https://youtube.com/watch?v=..." />
                <span asp-validation-for="YouTubeUrl" class="text-danger"></span>
            </div>

        </div>

        <!-- Botones -->
        <div class="mt-4 d-flex gap-2">
            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-secondary px-4">
                Volver
            </a>

            <button class="btn btn-primary px-4">
                Guardar
            </button>
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
``
