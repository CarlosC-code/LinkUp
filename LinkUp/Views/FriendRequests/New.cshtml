@{
    ViewData["Title"] = "Nueva solicitud";
}

<style>
    body {
        background-color: #212121;
        color: #e0e0e0;
    }

    .dark-card {
        background-color: #2a2a2a;
        border-radius: 14px;
        padding: 30px;
        max-width: 500px;
        margin: 60px auto;
        box-shadow: 0 0 25px rgba(0,0,0,0.4);
    }

    .form-control {
        background-color: #333;
        border: 1px solid #444;
        color: #fff;
    }

        .form-control:focus {
            background-color: #333;
            color: #fff;
            border-color: #666;
            box-shadow: none;
        }

    .btn-primary {
        background-color: #10a37f;
        border: none;
    }

        .btn-primary:hover {
            background-color: #0d8f6f;
        }

    .btn-secondary {
        background-color: #444;
        border: none;
    }

        .btn-secondary:hover {
            background-color: #555;
        }

    label {
        font-weight: 500;
    }
</style>

<div class="dark-card">

    <h3 class="mb-4 text-center">
        Enviar solicitud de amistad
    </h3>

    <form asp-controller="FriendRequests"
          asp-action="Send"
          method="post">

        @Html.AntiForgeryToken()

        <div class="mb-4">
            <label class="form-label">Nombre de usuario</label>
            <input name="toUserId"
                   class="form-control"
                   placeholder="usuario_destino"
                   required />
        </div>

        <div class="d-flex gap-2 justify-content-center">
            <button type="submit" class="btn btn-primary px-4">
                Enviar
            </button>

            <a asp-controller="FriendRequests"
               asp-action="Index"
               class="btn btn-secondary px-4">
                Volver
            </a>
        </div>

    </form>

</div>